      "dataRouteRegex": "^/_next/data/Kr_9gDNsn_gqjsHmLgVn\\-/blog/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/Kr_9gDNsn_gqjsHmLgVn\\-/blog/(?<nxtPslug>[^/]+?)\\.json$"
    },
    {
      "page": "/contact",
      "dataRouteRegex": "^/_next/data/Kr_9gDNsn_gqjsHmLgVn\\-/contact\\.json$"
