      "routeKeys": {},
      "namedRegex": "^/favorites(?:/)?$"
    },
    {
      "page": "/privacy-policy",
      "regex": "^/privacy\\-policy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy\\-policy(?:/)?$"
    }
  ],
  "dataRoutes": [
    {
      "page": "/",
      "dataRouteRegex": "^/_next/data/Kr_9gDNsn_gqjsHmLgVn\\-/index\\.json$"
    },
    {
      "page": "/about",
      "dataRouteRegex": "^/_next/data/Kr_9gDNsn_gqjsHmLgVn\\-/about\\.json$"
